{
  "name": "appora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "START_FRONTEND=0 bash scripts/start-local.sh",
    "dev:local": "bash scripts/start-local.sh",
    "router": "bash scripts/start-9router.sh",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "playwright test",
    "test:agent-regression": "./api/.venv/bin/python -m unittest discover -s api/tests -t . -v",
    "eval:agent": "./api/.venv/bin/python -m api.agent_evals",
    "bench:agent": "./api/.venv/bin/python -m api.aider_benchmarks",
    "bench:agent:aider": "./api/.venv/bin/python -m api.aider_benchmarks",
    "bench:agent:aider:setup": "./api/.venv/bin/python -m api.aider_benchmarks --setup",
    "bench:agent:aider:smoke": "./api/.venv/bin/python -m api.aider_benchmarks --run --num-tests 3 --threads 1",
    "bench:agent:internal": "./api/.venv/bin/python -m api.agent_benchmarks",
    "bench:agent:internal:live": "./api/.venv/bin/python -m api.agent_benchmarks --live",
    "bench:agent:internal:live:smoke": "./api/.venv/bin/python -m api.agent_benchmarks --live --scenario task_tracker_ui --workspace .tmp-agent-bench --output .tmp-agent-bench/latest-agent-benchmark.json --model kr/claude-haiku-4.5",
    "bench:agent:internal:live:full": "./api/.venv/bin/python -m api.agent_benchmarks --live --workspace .tmp-agent-bench-full --output .tmp-agent-bench/latest-agent-benchmark-full.json --scenario-timeout 180 --model kr/claude-haiku-4.5",
    "audit:preview": "node scripts/preview-audit.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.477.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-draggable": "^4.4.6",
    "sonner": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
